<?xml version="1.0" encoding="utf-8"?>
<!-- «ShoppingList Sfeer»: toont enkel de projectorpagina van «Ook rond de tv» schermvullend (zie MainActivity). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="be.shoppinglist.sfeer"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="ShoppingList Sfeer"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">
        <!-- Exported: de Pi start ze via ADB (`am start -n`). De activity zelf laat enkel de projectorpagina op het thuisnetwerk toe. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
