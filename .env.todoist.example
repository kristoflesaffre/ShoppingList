# Server-only Todoist configuration. Use ignored .env.local, never commit real values.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Generate once: openssl rand -base64 48
TODOIST_OAUTH_SECRET=
TODOIST_REDIRECT_URI=https://localhost:3011/api/todoist/callback
# Netlify production instead uses:
# TODOIST_REDIRECT_URI=https://shoppinglist-lesaffre.netlify.app/api/todoist/callback
# INSTANT_APP_ADMIN_TOKEN must already be configured to verify the Shopping List login.
