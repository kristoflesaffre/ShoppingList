# Kopieer naar `.env.local` en vul aan (zie README).
# Admin-token: Instant dashboard → je app → Settings / Admin.

INSTANT_APP_ADMIN_TOKEN=
# Komma-gescheiden e-mailadressen die het adminoverzicht mogen openen.
ADMIN_EMAILS=lesaffrekristof@gmail.com
# Optioneel: komma-gescheiden Instant user ids die het adminoverzicht mogen openen.
ADMIN_INSTANT_USER_IDS=
# Optioneel: nieuwe user-afbeeldingen in Vercel Blob opslaan.
# Zonder token valt de app terug op legacy data-URLs in InstantDB.
BLOB_READ_WRITE_TOKEN=
# Optioneel:
# NEXT_PUBLIC_INSTANT_APP_ID=
# IMDb-scores via OMDB (Vercel: Environments → OMDB_API_KEY, daarna redeploy)
OMDB_API_KEY=

# Google Calendar op het dashboard (alleen-lezen).
# Google Cloud: schakel Calendar API in en maak een OAuth 2.0 Web client.
# Redirect URI's lokaal:
# - http://localhost:3000/api/google/callback
# - http://127.0.0.1:3000/api/google/callback
# Redirect URI productie: https://<jouw-domein>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Minstens 32 willekeurige tekens, bv. `openssl rand -base64 32`.
GOOGLE_OAUTH_COOKIE_SECRET=
